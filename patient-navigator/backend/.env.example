# Copy this file to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres — used by dj-database-url. Example:
# postgres://patient_navigator:password@localhost:5432/patient_navigator
DATABASE_URL=postgres://patient_navigator:password@localhost:5432/patient_navigator

# Frontend origins allowed to call this API / send CSRF-protected requests
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Only relevant when DEBUG=False
SECURE_SSL_REDIRECT=False

# Navigator Agent / LLM provider (agents/core/llm.py)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Knowledge base ingestion/retrieval (knowledge/chunking.py, embeddings.py, retrieval.py)
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=150
EMBEDDING_DIM=2048
KNOWLEDGE_RETRIEVAL_TOP_K=3
KNOWLEDGE_MIN_SIMILARITY=0.15

