# Copy this file to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres — used by dj-database-url. Example:
# postgres://patient_navigator:password@localhost:5432/patient_navigator
DATABASE_URL=postgres://patient_navigator:password@localhost:5432/patient_navigator

# Frontend origins allowed to call this API / send CSRF-protected requests
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Only relevant when DEBUG=False
SECURE_SSL_REDIRECT=False

# Navigator Agent / LLM provider (agents/core/llm.py)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Knowledge base search (knowledge/embeddings.py, retrieval.py)
# voyage = Voyage AI (Anthropic's recommended embedding provider),
# openai = OpenAI embeddings, local = offline word matching (no API key,
# but only matches shared words, not meaning).
# After changing provider or model, re-run: python manage.py seed_knowledge_base
EMBEDDING_PROVIDER=voyage
EMBEDDING_API_KEY=
# Optional. Defaults: voyage-4 (voyage), text-embedding-3-small (openai)
EMBEDDING_MODEL=
# Only used by the local provider
EMBEDDING_DIM=2048
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_RETRIEVAL_TOP_K=3
# Minimum relevance score. Leave blank to use the model's default
# (voyage 0.4, openai 0.3, local 0.15); scores aren't comparable across models.
KNOWLEDGE_MIN_SIMILARITY=

# Human escalation (escalations/, agents/escalation/)
MAX_AGENT_FAILURES_BEFORE_ESCALATION=3
# Minutes a proposed agent action stays confirmable (appointments/models.py)
AGENT_ACTION_TTL_MINUTES=30
# Operational (not clinical) staff-dashboard targets, in minutes
NORMAL_ESCALATION_TARGET_MINUTES=60
HIGH_ESCALATION_TARGET_MINUTES=15
